# =============================================================================
# Arbitrum Orbit Chain Replica Nodes Configuration
# =============================================================================
# Copy this file to .env and update values for your chain
# =============================================================================

# -----------------------------------------------------------------------------
# Chain Identification
# -----------------------------------------------------------------------------
# Unique name for this chain (used for data directory: ./data/${CHAIN_NAME}/)
CHAIN_NAME=your-chain-name

# -----------------------------------------------------------------------------
# Nitro Node Configuration
# -----------------------------------------------------------------------------
# Docker image for the Nitro node (defaults will be used if empty)
NITRO_IMAGE=

# Host ports for Nitro node HTTP and WS endpoints
HTTP_PORT=8547
WS_PORT=8546

# -----------------------------------------------------------------------------
# Snapshot Restore
# -----------------------------------------------------------------------------
# Set to true before make setup to restore the latest requester-pays snapshot.
SNAPSHOT_ENABLED=false

# Google Cloud billing project used for requester-pays snapshot downloads.
# If empty, download-snapshot.sh falls back to the active gcloud project.
GCP_PROJECT=

# -----------------------------------------------------------------------------
# Chain RPC Endpoints
# -----------------------------------------------------------------------------
# Execution forwarding target (sequencer RPC)
FORWARDING_TARGET=https://rpc-${network-slug}.t.conduit.xyz

# Feed input URL (websocket relay)
SEQUENCER_FEED_RELAY=wss://relay-${network-slug}.t.conduit.xyz/

# Parent chain RPC URL (e.g., Ethereum mainnet, Arbitrum Sepolia)
PARENT_CHAIN_RPC=
# Parent chain beacon URL (required if parent chain is Ethereum mainnet)
PARENT_CHAIN_BEACON_URL=

# -----------------------------------------------------------------------------
# DAS Configuration (for docker-compose.das.yml)
# -----------------------------------------------------------------------------
# Data Availability Server URL
DAS_URL=https://${network-slug}.t.conduit.xyz

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
# Local L2 RPC URL for sync progress monitoring
L2_RPC_URL=http://localhost:8547

# -----------------------------------------------------------------------------
# Celestia Configuration (for docker-compose.celestia.yml)
# -----------------------------------------------------------------------------

# # Celestia DAS image
# CELESTIA_DAS_IMAGE=ghcr.io/celestiaorg/nitro-das-celestia:v0.5.6

# # Celestia RPC endpoint
# CELESTIA_RPC=

# # Celestia namespace ID
# CELESTIA_NAMESPACE_ID=00000000000000000000

# # Sequencer inbox address (from chain deployment, populated automatically)
# SEQUENCER_INBOX_ADDRESS=0x0000000000000000000000000000000000000000

